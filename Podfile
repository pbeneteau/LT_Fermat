
platform :ios, '11.0'

target 'LTios' do

  use_frameworks!

  # Firebase SDKs
  pod 'Firebase/Auth'
  pod 'Firebase/Firestore'
  pod 'Firebase/Storage'
  pod 'Firebase/Database'
  
  # Internet connection
  pod 'ReachabilitySwift'
  
  # Phone Numbers
  pod 'CryptoSwift'
  pod 'PhoneNumberKit'
  
  # Google SDKs
  pod 'GoogleMaps'
  pod 'GooglePlaces'
  
  # Snapchat SDK
  pod 'PINCache'
  pod 'SnapSDK'
  
  # View
  pod 'Spring', :git => 'https://github.com/MengTo/Spring.git' # pod 'Spring'
  pod 'ViewAnimator'
  pod 'SCLAlertView'
  pod 'NotificationBannerSwift'
  pod 'MarqueeLabel/Swift'
  pod 'SwipeMenuViewController'
  #pod 'TextFieldEffects'
  
  # Constraints
  pod 'SnapKit'

  target 'LTiosTests' do
    inherit! :search_paths
    # Pods for testing
  end

  target 'LTiosUITests' do
    inherit! :search_paths
    # Pods for testing
  end

end
